output "eDP-1" {
    scale 1.0
}

input {
    keyboard {
        xkb {}
    }
    touchpad {
        tap
        natural-scroll
    }
    focus-follows-mouse
    // workspace-auto-back-and-forth
}

layout {
    gaps 12
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    border {
        off
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
}

animations {
    workspace-switch { off; }
}

spawn-at-startup "noctalia" "-d"

window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}

binds {
    // Show hotkey overlay (Mapped to F1 instead of Mod+Shift+Slash to avoid 1Password conflict)
    Mod+F1 { show-hotkey-overlay; }

    // Core Applications (Configured with Kitty)
    Mod+Return { spawn "kitty"; }
    Mod+Alt+Return { spawn "kitty" "-e" "tmux" "attach" "||" "kitty" "-e" "tmux" "new" "-s" "Work"; }
    Mod+B { spawn "omarchy-launch-browser"; }
    Mod+Shift+Return { spawn "omarchy-launch-browser"; }
    Mod+Shift+Alt+B { spawn "omarchy-launch-browser" "--private"; }

    // Media & Hardware keys (Volume, Brightness, Playback)
    XF86AudioRaiseVolume { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute        { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute     { spawn "noctalia" "msg" "mic-mute"; }
    XF86MonBrightnessUp   { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown { spawn "noctalia" "msg" "brightness-down"; }
    XF86AudioPlay        { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioNext        { spawn "noctalia" "msg" "media" "next"; }
    XF86AudioPrev        { spawn "noctalia" "msg" "media" "previous"; }
    
    // File manager (SUPER + F is Nautilus in Omarchy)
    Mod+F { spawn "nautilus" "--new-window"; }
    
    // Utilities (T = btop, D = lazydocker)
    Mod+T { spawn "kitty" "-e" "btop"; }
    Mod+D { spawn "kitty" "-e" "lazydocker"; }
    
    // Media & Apps
    Mod+M { spawn "spotify"; }
    Mod+N { spawn "omarchy-launch-editor"; }
    Mod+Shift+W { spawn "typora" "--enable-wayland-ime"; }
    Mod+Shift+Slash { spawn "1password"; }

    // Webapps (Custom Omarchy targets)
    Mod+A { spawn "omarchy-launch-webapp" "https://gemini.google.com"; }
    Mod+Shift+A { spawn "omarchy-launch-webapp" "https://claude.ai"; }
    Mod+Y { spawn "omarchy-launch-or-focus-webapp" "YouTube" "https://youtube.com/"; }

    // Launcher & Clipboard (Noctalia integrated launcher)
    Alt+Space { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Ctrl+Alt+Shift+Space { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }

    // Navigation (Caps Lock + H/J/K/L maps to arrows via keyd)
    // SUPER + H/J/K/L and X/C are for focusing
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }
    Mod+X     { focus-column-left; }
    Mod+C     { focus-column-right; }

    // Moving windows around (SUPER + Arrow keys moves windows in Omarchy)
    Mod+Left  { move-column-left; }
    Mod+Down  { move-window-down; }
    Mod+Up    { move-window-up; }
    Mod+Right { move-column-right; }

    // Workspace Switching (Caps + 1..9 -> Ctrl+Alt+Shift+1..9)
    Ctrl+Alt+Shift+1 { focus-workspace 1; }
    Ctrl+Alt+Shift+2 { focus-workspace 2; }
    Ctrl+Alt+Shift+3 { focus-workspace 3; }
    Ctrl+Alt+Shift+4 { focus-workspace 4; }
    Ctrl+Alt+Shift+5 { focus-workspace 5; }
    Ctrl+Alt+Shift+6 { focus-workspace 6; }
    Ctrl+Alt+Shift+7 { focus-workspace 7; }
    Ctrl+Alt+Shift+8 { focus-workspace 8; }
    Ctrl+Alt+Shift+9 { focus-workspace 9; }

    // Move to Workspace (Caps + Shift + 1..9 -> Alt+Shift+1..9)
    Alt+Shift+1 { move-column-to-workspace 1; }
    Alt+Shift+2 { move-column-to-workspace 2; }
    Alt+Shift+3 { move-column-to-workspace 3; }
    Alt+Shift+4 { move-column-to-workspace 4; }
    Alt+Shift+5 { move-column-to-workspace 5; }
    Alt+Shift+6 { move-column-to-workspace 6; }
    Alt+Shift+7 { move-column-to-workspace 7; }
    Alt+Shift+8 { move-column-to-workspace 8; }
    Alt+Shift+9 { move-column-to-workspace 9; }

    // Window Actions
    Ctrl+Alt+Shift+W { close-window; }
    Mod+Q { close-window; }

    Ctrl+Alt+Shift+F { fullscreen-window; }
    Mod+Shift+F { maximize-column; } // Reassigned from Mod+F to avoid Nautilus conflict

    Ctrl+Alt+Shift+T { toggle-window-floating; }
    Mod+V { toggle-window-floating; }

    Ctrl+Alt+Shift+G { toggle-column-tabbed-display; }

    // Screenshot Keys
    Ctrl+Alt+Shift+S { spawn "noctalia" "msg" "screenshot-fullscreen"; }
    Ctrl+Alt+Shift+X { spawn "noctalia" "msg" "screenshot-region"; }
    Print { spawn "noctalia" "msg" "screenshot-region"; }

    // Layout resizing
    Mod+R { switch-preset-column-width; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // Quit session
    Mod+Shift+E { quit; }
}
