# Sway Configuration file stowed via dotfiles-fedora
# inspired by i3 and customized for keyd modifiers

# Default modifier
set $mod Mod4

# Set default shell and terminal
set $term kitty
set $browser helium

# Font
font pango:JetBrains Mono 10

# Gaps (i3-gaps style)
gaps inner 4
gaps outer 0
smart_gaps on
smart_borders on

# Touchpad configuration
input type:touchpad {
    tap enabled
    natural_scroll enabled
}

input type:pointer {
    pointer_accel -0.2
    accel_profile flat
}

# Floating window modifier (Hold Super/Win and drag to move/resize floating windows)
floating_modifier $mod

# Borders
default_border pixel 2
default_floating_border normal 2

# Colors matching i3 classic (slate blue active, dark grey inactive)
client.focused #4c7899 #4c7899 #ffffff #2e9ef4 #4c7899
client.unfocused #333333 #333333 #888888 #292929 #333333

# Autostart Desktop Services (Waybar, SwayNC, Cliphist, Snipaste, and Portals)
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway
exec systemctl --user stop xdg-desktop-portal xdg-desktop-portal-wlr xdg-desktop-portal-gtk 2>/dev/null || true
exec /usr/libexec/xdg-desktop-portal-wlr &
exec /usr/libexec/xdg-desktop-portal-gtk &
exec /usr/libexec/xdg-desktop-portal &
exec waybar
exec swaync
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec Snipaste
exec nm-applet &
exec_always sh -c "pkill autotiling; /home/limxuan/.local/bin/autotiling"



# Keybindings
# 1. Terminals and Launcher
bindsym $mod+Return exec $term
bindsym Mod1+space exec wofi --show drun
bindsym --inhibited Ctrl+Mod1+Shift+space exec /home/limxuan/.config/scripts/fzf-clipboard.sh


# 2. Kill focused window
bindsym $mod+q kill
bindsym Ctrl+Mod1+Shift+w kill

# 3. Focus navigation
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# 4. Moving windows
bindsym $mod+Left move left
bindsym $mod+Down move down
bindsym $mod+Up move up
bindsym $mod+Right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# 4b. Resizing windows
bindsym $mod+minus resize shrink width 50 px or 5 ppt; resize shrink height 50 px or 5 ppt
bindsym $mod+equal resize grow width 50 px or 5 ppt; resize grow height 50 px or 5 ppt
bindsym $mod+plus resize grow width 50 px or 5 ppt; resize grow height 50 px or 5 ppt

# 5. Workspaces Switching (keyd maps Caps+1..9 to Ctrl+Shift+Alt+1..9)
bindsym --inhibited Ctrl+Mod1+Shift+1 workspace number 1
bindsym --inhibited Ctrl+Mod1+Shift+2 workspace number 2
bindsym --inhibited Ctrl+Mod1+Shift+3 workspace number 3
bindsym --inhibited Ctrl+Mod1+Shift+4 workspace number 4
bindsym --inhibited Ctrl+Mod1+Shift+5 workspace number 5
bindsym --inhibited Ctrl+Mod1+Shift+6 workspace number 6
bindsym --inhibited Ctrl+Mod1+Shift+x exec sleep 0.15 && swaymsg workspace number 6
bindsym --inhibited Ctrl+Mod1+Shift+7 workspace number 7
bindsym --inhibited Ctrl+Mod1+Shift+8 workspace number 8
bindsym --inhibited Ctrl+Mod1+Shift+9 workspace number 9


# 6. Move container to Workspaces (keyd maps Caps+Shift+1..9 to Alt+Shift+1..9)
bindsym Mod1+Shift+1 move container to workspace number 1
bindsym Mod1+Shift+2 move container to workspace number 2
bindsym Mod1+Shift+3 move container to workspace number 3
bindsym Mod1+Shift+4 move container to workspace number 4
bindsym Mod1+Shift+5 move container to workspace number 5
bindsym Mod1+Shift+6 move container to workspace number 6
bindsym Mod1+Shift+7 move container to workspace number 7
bindsym Mod1+Shift+8 move container to workspace number 8
bindsym Mod1+Shift+9 move container to workspace number 9

# 7. Hardware Media Keys
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# 8. Screenshots & Pinning (Flameshot + Snipaste)
bindsym Print exec grim -g "$(slurp)" - | swappy -f -
bindsym --inhibited Ctrl+Mod1+Shift+s exec grim -g "$(slurp)" - | swappy -f -
bindsym Ctrl+Mod1+Shift+d exec ~/.config/scripts/paste-clipboard.fish
bindsym Shift+Print exec grim - | wl-copy && notify-send "Screenshot" "Fullscreen copied to clipboard"

# 9. Utilities
bindsym $mod+f exec nautilus --new-window
bindsym $mod+t exec kitty --class btop-floating -e btop
bindsym $mod+d exec kitty -e lazydocker
bindsym $mod+m exec pavucontrol
bindsym $mod+a exec helium --new-window "https://gemini.google.com" "https://chatgpt.com" "https://claude.ai" "https://grok.com" "https://chat.deepseek.com"
bindsym $mod+c exec helium --new-window "https://web.whatsapp.com" "https://web.telegram.org" "https://discord.com/app"


# 10. Split orientation
bindsym $mod+Shift+b splith
bindsym $mod+v splitv
bindsym $mod+b exec $browser

# 11. Toggle fullscreen / floating
bindsym $mod+Shift+f fullscreen toggle
bindsym Ctrl+Mod1+Shift+f fullscreen toggle
bindsym $mod+Shift+t floating toggle
bindsym Ctrl+Mod1+Shift+t floating toggle

# 12. Reload config / Exit sway
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit Sway?' -b 'Yes' 'swaymsg exit'

# 13. Window rules for pinned screenshots (imv / flameshot)
for_window [app_id="imv"] floating enable, border none, sticky enable
for_window [app_id="Snipaste"] floating enable, border none, sticky enable
for_window [class="Snipaste"] floating enable, border none, sticky enable
for_window [app_id="swappy"] floating enable, border none, resize set 1200 800, move position center
for_window [app_id="Impala"] floating enable, resize set 800 600, move position center
for_window [app_id="BlueTUI"] floating enable, resize set 800 600, move position center
for_window [app_id="Wiremix"] floating enable, resize set 800 450, move position center
for_window [app_id="pavucontrol"] floating enable, resize set 800 600, move position center
for_window [app_id="fzf-clip"] floating enable, resize set 1000 650, move position center
for_window [class="fzf-clip"] floating enable, resize set 1000 650, move position center
for_window [app_id="btop-floating"] floating enable, resize set 1000 650, move position center

# 14. Monitor and Workspace configuration
# Set external monitor (HDMI-A-1) as the main monitor and internal monitor (eDP-1) as secondary
output HDMI-A-1 pos 0 0
output eDP-1 pos 0 1080

# Bind workspaces 1-6 to the main (external) monitor, and workspace 7 to the internal monitor
workspace 1 output HDMI-A-1
workspace 2 output HDMI-A-1
workspace 3 output HDMI-A-1
workspace 4 output HDMI-A-1
workspace 5 output HDMI-A-1
workspace 6 output HDMI-A-1
workspace 7 output eDP-1
